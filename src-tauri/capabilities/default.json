{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-ask",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/gs",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/qpdf",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:default"
  ]
}
